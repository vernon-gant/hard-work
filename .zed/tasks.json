[
  {
    "label": "Go Test - Manual Folder",
    "command": "go",
    "args": ["test", "-v", "./11_bloom_filter"],
    "cwd": "${ZED_WORKTREE_ROOT}/algos1-go",
  },
  {
    "label": "Go Build - Manual Folder",
    "command": "go",
    "args": ["build", "-v", "./11_bloom_filter"],
    "cwd": "${ZED_WORKTREE_ROOT}/algos1-go",
  },
  {
    "label": "🐍 algos3-python pytest: all",
    "command": "venv/Scripts/python.exe",
    "args": ["-m", "pytest"],
    "cwd": "${ZED_WORKTREE_ROOT}/algos3-python",
  },
  {
    "label": "🐍 algos3-python pytest: current file's tests",
    "command": "venv/Scripts/python.exe",
    "args": ["-m", "pytest", "-k", "${ZED_STEM}"],
    "cwd": "${ZED_WORKTREE_ROOT}/algos3-python",
  },
  {
    "label": "🐍 algos3-python pytest: test under cursor",
    "command": "venv/Scripts/python.exe",
    "args": ["-m", "pytest", "-k", "${ZED_SYMBOL}"],
    "cwd": "${ZED_WORKTREE_ROOT}/algos3-python",
    "tags": ["py-test"],
  },
  {
    "label": "🐍 algos3-python: copy github url",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      "Set-Clipboard",
      "-Value",
      "https://github.com/vernon-gant/hard-work/tree/master/algos3-python/src"
    ],
    "reveal": "never"
  }
]
